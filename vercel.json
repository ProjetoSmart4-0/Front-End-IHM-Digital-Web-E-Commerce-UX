
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://auth-gateway-gcp-url.run.app/:path*"
    },
    {
      "source": "/api/iot/:path*",
      "destination": "https://iot-service-gcp-url.run.app/:path*"
    },
    {
      "source": "/api/cobot/:path*",
      "destination": "https://cobot-service-gcp-url.run.app/:path*"
    },
    {
      "source": "/api/mes/:path*",
      "destination": "https://mes-service-gcp-url.run.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
